# .env.local.example
# Local deployment configuration - No Cloudflare, No Authelia
# Copy this to .env and customize

# =============================================================================
# GENERAL SETTINGS
# =============================================================================
TIMEZONE=America/New_York
PUID=1000
PGID=1000
DOCKER_NETWORK=mediastack

# Profiles to enable (comma-separated)
# Options: plex, jellyfin, arr, torrent, stats
COMPOSE_PROFILES=plex,arr,torrent

# =============================================================================
# STORAGE PATHS
# =============================================================================
DATA_ROOT=/srv/mediastack
CONFIG_ROOT=/srv/mediastack/config
MOVIES_PATH=/srv/mediastack/media/movies
TV_SHOWS_PATH=/srv/mediastack/media/tv
MUSIC_PATH=/srv/mediastack/media/music
DOWNLOADS_PATH=/srv/mediastack/downloads
TRANSCODE_PATH=/srv/mediastack/transcode

# =============================================================================
# TRAEFIK (Local Reverse Proxy)
# =============================================================================
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# =============================================================================
# SERVICE CREDENTIALS
# =============================================================================
# Master password for services that need one
MASTER_PASSWORD=changeme

# Plex claim token (get from https://plex.tv/claim)
PLEX_CLAIM=

# =============================================================================
# ACCESS URLS
# =============================================================================
# Add these to your /etc/hosts file:
#
# On Linux/Mac, edit /etc/hosts:
#   sudo nano /etc/hosts
#
# On Windows, edit C:\Windows\System32\drivers\etc\hosts
#
# Add this line (replace 192.168.1.100 with your server IP):
#   192.168.1.100 home.local plex.local sonarr.local radarr.local prowlarr.local bazarr.local overseerr.local qbit.local tautulli.local traefik.local jellyfin.local
#
# Then access:
#   Dashboard:    http://home.local
#   Plex:         http://localhost:32400/web (or Plex app)
#   Sonarr:       http://sonarr.local
#   Radarr:       http://radarr.local
#   Prowlarr:     http://prowlarr.local
#   Bazarr:       http://bazarr.local
#   Overseerr:    http://overseerr.local
#   qBittorrent:  http://qbit.local
#   Tautulli:     http://tautulli.local
#   Traefik:      http://traefik.local or http://localhost:8080
