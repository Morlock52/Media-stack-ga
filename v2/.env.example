# =============================================================================
#  Media Stack v2 — copy to .env, chmod 600, never commit.
#  Generate secrets:  openssl rand -hex 32
# =============================================================================

# ---- Profiles: pick layers ----------------------------------------------------
# core + ops are always on. Options: torrent arr music plex jellyfin stats books
#                                    remote backup observability
#   extras: usenet crossseed 4k jellystat   (books also enables Chaptarr)
COMPOSE_PROFILES=torrent,arr,plex,remote,backup

# ---- General ------------------------------------------------------------------
TZ=America/New_York
PUID=1000
PGID=1000
DOMAIN=media.example.com
ACME_EMAIL=you@example.com
LAN_SUBNET=192.168.1.0/24

# ---- Paths (TRaSH layout — ONE filesystem for torrents + media) ----------------
# DATA_ROOT
# ├── torrents/{tv,movies,music,books}
# └── media/{tv,movies,music,books,audiobooks,podcasts}
DATA_ROOT=/srv/data
CONFIG_ROOT=/srv/appdata
BACKUP_REPO_PATH=/srv/backups

# ---- Edge / auth ----------------------------------------------------------------
CF_DNS_API_TOKEN=                 # Cloudflare token: Zone → DNS → Edit, one zone
CLOUDFLARE_TUNNEL_TOKEN=          # only for the `remote` profile
POCKETID_URL=https://id.example.com
POCKETID_CLIENT_ID=
POCKETID_CLIENT_SECRET=
AUTH_ALLOWED_EMAILS=you@example.com

# ---- VPN (PIA via gluetun, OpenVPN + port forwarding) --------------------------
PIA_USER=
PIA_PASS=
PIA_REGIONS="CA Montreal,CA Toronto"
GLUETUN_API_KEY=                  # openssl rand -hex 16

# ---- App API keys (fill after first start; from each app's Settings → General) -
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
RADARR_4K_API_KEY=
SABNZBD_API_KEY=
SEERR_API_KEY=
PLEX_TOKEN=
PLEX_CLAIM=                       # https://www.plex.tv/claim (valid 4 minutes)

# ---- Ops -------------------------------------------------------------------------
GRAFANA_PASSWORD=
WUD_ADMIN_PASSWORD=               # openssl rand -hex 16  (WUD login, user "admin")
PROXY_SUBNET=172.16.0.0/12        # Docker bridge range Tinyauth trusts for X-Forwarded-*

# ---- Extras -----------------------------------------------------------------------
JELLYSTAT_DB_PASSWORD=            # openssl rand -hex 16   (profile: jellystat)
JELLYSTAT_JWT_SECRET=             # openssl rand -hex 32
